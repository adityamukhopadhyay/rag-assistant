# Copy to .env for local runs. On Railway these are service variables (scripts/railway_provision.py sets them).
GEMINI_API_KEY=
# Qdrant: leave QDRANT_URL empty locally (embedded mode at .qdrant/). On Railway:
#   QDRANT_URL=http://qdrant.railway.internal:6333   QDRANT_API_KEY=<the qdrant service's QDRANT__SERVICE__API_KEY>
QDRANT_URL=
QDRANT_API_KEY=
ADMIN_TOKEN=change-me
# Pipeline settings — eval/run_eval.py --persist (or eval/merge.py --persist) writes the A/B winner here
ACTIVE_PIPELINE=a
QUERY_EXPANSION=false
RERANK=true
PUBLIC_DOCS=true
CORS_ORIGINS=https://adityamukhopadhyay.vercel.app,http://localhost:3000
# Uncached questions per visitor per 24 h in production; 0 = unlimited for local testing
RATE_LIMIT_PER_USER=0
